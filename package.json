    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@types/node": "^22.19.19",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3"
  }
}
