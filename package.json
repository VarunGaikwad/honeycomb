{
  "name": "bi",
  "version": "1.1.0",
  "description": "Pi coding agent extension",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VarunGaikwad/bi.git"
  },
  "homepage": "https://github.com/VarunGaikwad/bi#readme",
  "bugs": {
    "url": "https://github.com/VarunGaikwad/bi/issues"
  },
  "author": "Varun Gaikwad",
  "license": "ISC",
  "files": [
    "src/",
    "themes/",
    "plan/tool-parity.md",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "themes": [
      "./themes/*.json"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.test.ts"
  },
